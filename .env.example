# ==========================================
# Touch Grass Environment Configuration
# ==========================================

# Runtime Environment
NODE_ENV=development

# Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Backend (apps/api)
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Database (packages/db)
# Provide your MongoDB Atlas connection string or local MongoDB instance
MONGODB_URI=mongodb://localhost:27017/touch_grass
MONGODB_DATABASE=touch_grass

# Authentication (apps/api)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_dev
JWT_EXPIRES_IN=7d

# AI Model Provider (packages/ai)
# Supported providers: 'mock', 'groq', 'together', 'ollama', 'openrouter'
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gemma-2-9b-it
AI_REQUEST_TIMEOUT_MS=30000

# Image Evidence Storage (Cloudinary - optional in dev/mock mode)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Logging
LOG_LEVEL=info
